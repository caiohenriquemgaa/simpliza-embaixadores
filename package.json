{
  "name": "simpliza-embaixadores",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "install:ci": "npm ci",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vercel": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/datacrazy.test.mjs tests/manual-retry.test.mjs tests/phone-mask.test.mjs tests/rendered-html.test.mjs tests/upload-validation.test.mjs tests/validation.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:vercel",
    "db:generate": "drizzle-kit generate",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:migration:new": "supabase migration new",
    "db:types": "supabase gen types typescript --linked --schema public",
    "db:seed:empty": "supabase db push --linked --include-seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.2",
    "react-server-dom-webpack": "^19.2.8",
    "supabase": "^2.115.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "type": "module",
  "displayName": "Simpliza — Programa de Embaixadores"
}
