# Valores públicos; podem ser expostos ao navegador.
NEXT_PUBLIC_SUPABASE_URL=SUBSTITUA_AQUI_URL_DO_PROJETO_SUPABASE
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_AQUI_CHAVE_PUBLICAVEL_SUPABASE
NEXT_PUBLIC_SITE_URL=SUBSTITUA_AQUI_URL_PUBLICA_DO_SITE

# Exclusivamente no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=SUBSTITUA_AQUI_CHAVE_SECRETA_SUPABASE

# Identificador público usado pelo Supabase CLI para vincular o projeto.
SUPABASE_PROJECT_REF=SUBSTITUA_AQUI_PROJECT_REF_SUPABASE

# IDs públicos opcionais para eventos de conversão.
NEXT_PUBLIC_GA4_ID=SUBSTITUA_AQUI_ID_GA4_OU_DEIXE_VAZIO
NEXT_PUBLIC_META_PIXEL_ID=SUBSTITUA_AQUI_ID_META_PIXEL_OU_DEIXE_VAZIO

# DataCrazy: integração começa desativada. Todos os valores abaixo são exclusivos do servidor.
DATACRAZY_INTEGRATION_ENABLED=false
DATACRAZY_API_URL=https://api.g1.datacrazy.io/api/v1
DATACRAZY_API_TOKEN=SUBSTITUA_AQUI_TOKEN_DATACRAZY
DATACRAZY_PIPELINE_ID=SUBSTITUA_AQUI_ID_FUNIL_DATACRAZY
DATACRAZY_STAGE_ID=SUBSTITUA_AQUI_ID_ETAPA_DATACRAZY
DATACRAZY_ATTENDANT_ID=SUBSTITUA_AQUI_ID_ATENDENTE_DATACRAZY
DATACRAZY_TAG_LP_EMBAIXADORES_ID=SUBSTITUA_AQUI_ID_TAG_DATACRAZY
DATACRAZY_TIMEOUT_MS=8000
CRON_SECRET=SUBSTITUA_AQUI_SEGREDO_ALEATORIO_DO_CRON

# Modo seguro para uma ativação manual com somente um contato previamente autorizado.
DATACRAZY_MANUAL_TEST_MODE=false
DATACRAZY_MANUAL_TEST_EMAIL=SUBSTITUA_AQUI_EMAIL_FICTICIO_AUTORIZADO
DATACRAZY_MANUAL_TEST_PHONE=SUBSTITUA_AQUI_TELEFONE_FICTICIO_AUTORIZADO

# IDs de campos personalizados. A API oficial ainda não documenta o formato ID/valor do payload.
DATACRAZY_FIELD_SOURCE_MAIN_ID=SUBSTITUA_AQUI_ID_CAMPO_ORIGEM_PRINCIPAL
DATACRAZY_FIELD_AMBASSADOR_NAME_ID=SUBSTITUA_AQUI_ID_CAMPO_EMBAIXADOR
DATACRAZY_FIELD_AMBASSADOR_ID=SUBSTITUA_AQUI_ID_CAMPO_EMBAIXADOR_ID
DATACRAZY_FIELD_AMBASSADOR_SLUG_ID=SUBSTITUA_AQUI_ID_CAMPO_EMBAIXADOR_SLUG
DATACRAZY_FIELD_CAMPAIGN_CODE_ID=SUBSTITUA_AQUI_ID_CAMPO_CODIGO_CAMPANHA
DATACRAZY_FIELD_SOURCE_PAGE_ID=SUBSTITUA_AQUI_ID_CAMPO_PAGINA_ORIGEM
DATACRAZY_FIELD_SOURCE_URL_ID=SUBSTITUA_AQUI_ID_CAMPO_URL_ORIGEM
DATACRAZY_FIELD_MONTHLY_REVENUE_ID=SUBSTITUA_AQUI_ID_CAMPO_FATURAMENTO
DATACRAZY_FIELD_CONTACT_PREFERENCE_ID=SUBSTITUA_AQUI_ID_CAMPO_PREFERENCIA_CONTATO
DATACRAZY_FIELD_UTM_SOURCE_ID=SUBSTITUA_AQUI_ID_CAMPO_UTM_SOURCE
DATACRAZY_FIELD_UTM_MEDIUM_ID=SUBSTITUA_AQUI_ID_CAMPO_UTM_MEDIUM
DATACRAZY_FIELD_UTM_CAMPAIGN_ID=SUBSTITUA_AQUI_ID_CAMPO_UTM_CAMPAIGN
DATACRAZY_FIELD_UTM_CONTENT_ID=SUBSTITUA_AQUI_ID_CAMPO_UTM_CONTENT
DATACRAZY_FIELD_UTM_TERM_ID=SUBSTITUA_AQUI_ID_CAMPO_UTM_TERM
DATACRAZY_FIELD_EXTERNAL_ID=SUBSTITUA_AQUI_ID_CAMPO_ID_EXTERNO_LP
DATACRAZY_FIELD_ESTABLISHMENT_ID=SUBSTITUA_AQUI_ID_CAMPO_ESTABELECIMENTO
DATACRAZY_FIELD_CITY_ID=SUBSTITUA_AQUI_ID_CAMPO_CIDADE
DATACRAZY_FIELD_CONSENT_ID=SUBSTITUA_AQUI_ID_CAMPO_CONSENTIMENTO
DATACRAZY_FIELD_CONSENT_AT_ID=SUBSTITUA_AQUI_ID_CAMPO_DATA_CONSENTIMENTO
