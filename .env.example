# Valores públicos; podem ser expostos ao navegador.
NEXT_PUBLIC_SUPABASE_URL=SUBSTITUA_AQUI_URL_DO_PROJETO_SUPABASE
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_AQUI_CHAVE_PUBLICAVEL_SUPABASE
NEXT_PUBLIC_SITE_URL=SUBSTITUA_AQUI_URL_PUBLICA_DO_SITE

# Exclusivamente no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=SUBSTITUA_AQUI_CHAVE_SECRETA_SUPABASE

# Identificador público usado pelo Supabase CLI para vincular o projeto.
SUPABASE_PROJECT_REF=SUBSTITUA_AQUI_PROJECT_REF_SUPABASE

# IDs públicos opcionais para eventos de conversão.
NEXT_PUBLIC_GA4_ID=SUBSTITUA_AQUI_ID_GA4_OU_DEIXE_VAZIO
NEXT_PUBLIC_META_PIXEL_ID=SUBSTITUA_AQUI_ID_META_PIXEL_OU_DEIXE_VAZIO
